            "description": "Saves the JWT into the collection variable `token`; all other requests use it as Bearer token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{password}}\"\n}",
