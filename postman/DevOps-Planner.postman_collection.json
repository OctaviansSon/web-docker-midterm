                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "const t = pm.response.json();",
                  "pm.test(\"Token returned\", function () { pm.expect(t.access_token).to.be.a(\"string\"); pm.expect(t.token_type).to.eql(\"bearer\"); });",
                  "pm.collectionVariables.set(\"token\", t.access_token);"
                ]
              }
            }
          ]
        },
