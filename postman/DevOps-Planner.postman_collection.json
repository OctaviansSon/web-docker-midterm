    {
      "name": "3. Tasks",
      "item": [
        {
          "name": "Create task (assigned to member)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/teams/{{teamId}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "teams",
                "{{teamId}}",
                "tasks"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Design a VPC with public/private subnets\",\n  \"description\": \"CIDR, route tables, NAT gateway\",\n  \"category\": \"aws\",\n  \"priority\": \"high\",\n  \"status\": \"backlog\",\n  \"due_date\": \"2030-12-31\",\n  \"assignee_id\": \"{{memberId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.request.body.update(pm.request.body.raw.replace('\"{{memberId}}\"', pm.collectionVariables.get(\"memberId\")));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
                  "const t = pm.response.json();",
                  "pm.test(\"Task created in backlog\", function () { pm.expect(t.status).to.eql(\"backlog\"); pm.expect(t.assignee_id).to.eql(Number(pm.collectionVariables.get(\"memberId\"))); });",
                  "pm.collectionVariables.set(\"taskId\", t.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create task (Kubernetes)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/teams/{{teamId}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "teams",
                "{{teamId}}",
                "tasks"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"etcd backup and restore\",\n  \"category\": \"kubernetes\",\n  \"priority\": \"medium\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{memberToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
