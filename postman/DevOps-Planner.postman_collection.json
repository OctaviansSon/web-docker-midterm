{
  "info": {
    "name": "DevOps Study Planner API",
    "description": "Run the whole collection with the Collection Runner (top to bottom). Folder 1 registers users and stores JWT tokens in collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "memberToken",
      "value": ""
    },
    {
      "key": "ownerId",
      "value": ""
    },
    {
      "key": "memberId",
      "value": ""
    },
    {
      "key": "ownerUsername",
      "value": ""
    },
    {
      "key": "ownerEmail",
      "value": ""
    },
    {
      "key": "memberUsername",
      "value": ""
    },
    {
      "key": "memberEmail",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "teamId",
      "value": ""
    },
    {
      "key": "taskId",
      "value": ""
    },
    {
      "key": "task2Id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. System",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Database is up\", function () { pm.expect(pm.response.json().database).to.eql(\"up\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register owner",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Creates the team owner. Username and e-mail are generated in the pre-request script, so the request can be run many times.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{ownerUsername}}\",\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id = Date.now();",
                  "pm.collectionVariables.set(\"ownerUsername\", \"owner\" + (id % 1000000));",
                  "pm.collectionVariables.set(\"ownerEmail\", \"owner\" + id + \"@example.com\");",
                  "pm.collectionVariables.set(\"memberUsername\", \"member\" + (id % 1000000));",
                  "pm.collectionVariables.set(\"memberEmail\", \"member\" + id + \"@example.com\");",
                  "pm.collectionVariables.set(\"password\", \"secret123\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
                  "const u = pm.response.json();",
                  "pm.test(\"User returned without password\", function () { pm.expect(u).to.have.property(\"id\"); pm.expect(u).to.not.have.property(\"password_hash\"); });",
                  "pm.collectionVariables.set(\"ownerId\", u.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register member",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
